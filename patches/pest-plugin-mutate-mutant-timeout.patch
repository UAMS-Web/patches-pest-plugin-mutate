+    /**
+     * The initial suite duration restated as the serial work it stands for.
+     *
+     * A `--parallel` run times the initial suite across N workers, so it reads about 1/N of
+     * the time one mutant child needs to run its covering tests serially, while up to N
+     * children run at once and contend for the same cores. The limit is sized from this
+     * figure, so a child that does nothing wrong exceeded it and was scored a timeout, which
+     * the run reports as unverified and which keeps `--min=100` out of reach. N is the run's
+     * process count, 1 when the run is not parallel, so a serial run keeps the plugin's limit
+     * unchanged. See UAMS-Web/patches-pest-plugin-mutate#2 and aether-multisite-forms#234.
+     */
+    public static function serialBasis(float $initialTestSuiteDuration, int $processes): float
+    {
+        return $initialTestSuiteDuration * max(1, $processes);
+    }
