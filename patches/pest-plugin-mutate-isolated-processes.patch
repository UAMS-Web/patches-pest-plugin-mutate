diff --git a/src/Autoload.php b/src/Autoload.php
new file mode 100644
--- /dev/null
+++ b/src/Autoload.php
@@ -0,0 +1,18 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Pest\Mutate;
+
+use Pest\Mutate\Plugins\Mutate;
+use Pest\Mutate\Support\StreamWrapper;
+
+// Composer also runs in isolated PHPUnit children, without Pest's kernel. Mutate::boot() starts
+// the wrapper too where this file is not loaded, so the constant keeps it to one start.
+if (getenv(Mutate::ENV_MUTATION_TESTING) !== false && ! defined('PEST_MUTATE_STREAM_WRAPPER_STARTED')) {
+    StreamWrapper::start(
+        (string) getenv(Mutate::ENV_MUTATION_TESTING),
+        (string) getenv(Mutate::ENV_MUTATION_FILE),
+    );
+    define('PEST_MUTATE_STREAM_WRAPPER_STARTED', true);
+}
