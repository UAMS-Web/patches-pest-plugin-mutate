new file mode 100644
--- /dev/null
+++ b/src/Autoload.php
@@ -0,0 +1,16 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Pest\Mutate;
+
+use Pest\Mutate\Plugins\Mutate;
+use Pest\Mutate\Support\StreamWrapper;
+
+// Composer also runs in isolated PHPUnit children, without Pest's kernel.
+if (getenv(Mutate::ENV_MUTATION_TESTING) !== false) {
+    StreamWrapper::start(
+        (string) getenv(Mutate::ENV_MUTATION_TESTING),
+        (string) getenv(Mutate::ENV_MUTATION_FILE),
+    );
+}
